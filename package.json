{
  "name": "scribble-royale",
  "version": "1.0.0",
  "private": true,
  "description": "Scribble Royale — Dragon Dynasty Web3 Multiplayer Drawing & Guessing Arena",
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace backend",
    "dev:web": "npm run dev --workspace frontend",
    "build": "npm run build --workspace frontend",
    "start:api": "npm run start --workspace backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
